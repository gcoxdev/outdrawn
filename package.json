{
  "name": "outdrawn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "host:https": "node scripts/serve-https.mjs",
    "test": "vitest run",
    "test:host": "node --test tests/hosting.test.mjs tests/offline.test.mjs tests/artwork.test.mjs tests/icons.test.mjs",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "predev": "node scripts/generate-icons.mjs && node scripts/optimize-artwork.mjs",
    "prebuild": "node scripts/generate-icons.mjs && node scripts/optimize-artwork.mjs",
    "test:mobile": "npm run build && node scripts/mobile-smoke.mjs",
    "test:lobby": "npm run build && node scripts/lobby-smoke.mjs",
    "test:two-player": "npm run build && node scripts/two-player-smoke.mjs",
    "test:lobby-reset": "npm run build && node scripts/lobby-reset-smoke.mjs",
    "test:menu": "npm run build && node scripts/menu-smoke.mjs",
    "test:card-backs": "npm run build && node scripts/card-back-smoke.mjs",
    "test:table": "npm run build && node scripts/table-smoke.mjs",
    "test:dev": "node scripts/dev-smoke.mjs",
    "test:dialogs": "npm run build && node scripts/dialog-smoke.mjs",
    "test:decisions": "npm run build && node scripts/decision-smoke.mjs",
    "verify": "node scripts/verify.mjs",
    "balance:report": "node scripts/balance-report.mjs",
    "test:actions": "npm run build && node scripts/action-smoke.mjs",
    "test:pacing": "npm run build && node scripts/pacing-smoke.mjs",
    "test:revive": "npm run build && node scripts/revive-smoke.mjs",
    "cards:render": "node card-production/render.mjs",
    "cards:verify": "node card-production/verify.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.27.7",
    "playwright": "^1.64.0",
    "sharp": "^0.35.5",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
